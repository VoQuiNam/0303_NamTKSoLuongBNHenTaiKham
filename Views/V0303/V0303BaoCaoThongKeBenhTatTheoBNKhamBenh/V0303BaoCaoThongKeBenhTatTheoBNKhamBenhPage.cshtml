@{
    ViewData["NonSixOs"] = true;
}

@using Nam_ThongKeSoLuongBNHenTaiKham.Models.M0303
@model List<M0303BaoCaoDoiSoatBIDVSTO>

<head>
    <link href="~/dist/css/CSS0303/CSS0303BaoCaoThongKeBenhTatTheoBNKhamBenh.css" rel="stylesheet" />
    <link href="~/dist/lib/bootstrap-datepicker-1.10.0/dist/css/bootstrap-datepicker.min.css" rel="stylesheet" />
    <link href="~/dist/lib/toastr/toastr.min.css" rel="stylesheet" />
</head>

<style>
    .table-wrapper-scroll th,
    .table-wrapper-scroll td {
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .table-wrapper-scroll table {
        table-layout: fixed;
    }

    .table-wrapper-scroll th:nth-child(1),
    .table-wrapper-scroll td:nth-child(1) {
        padding-left: 6px !important;
    }

    .table-wrapper-scroll th:nth-child(2),
    .table-wrapper-scroll td:nth-child(2) {
        width: 112px;
        min-width: 215px;
        max-width: 112px;
    }

    .table-wrapper-scroll th:nth-child(2),
    .table-wrapper-scroll td:nth-child(2) {
        position: sticky;
        left: 0;
        z-index: 100;
        background-color: white;
    }

    .table-wrapper-scroll th:last-child,
    .table-wrapper-scroll td:last-child,
    .table-wrapper-scroll th:nth-last-child(2),
    .table-wrapper-scroll td:nth-last-child(2) {
        width: 103px !important;
        min-width: 103px !important;
        max-width: 103px !important;
        padding-left: 12px !important;
    }

    .table-wrapper-scroll th:nth-child(-n+2) {
        position: sticky;
        top: 0;
        z-index: 101;
        background-color: #f2f2f2;
    }

    .table-wrapper-scroll th:nth-child(2) {
        left: 0;
    }

    .table-wrapper-scroll th:nth-child(-n+2),
    .table-wrapper-scroll td:nth-child(-n+2) {
        border-right: 1px solid #ccc !important;
    }

    .table-wrapper-scroll tr:hover td:nth-child(-n+2) {
        background-color: #bae7ff !important;
    }

    .table-wrapper-scroll tr.selected td:nth-child(-n+2) {
        background-color: #bae7ff !important;
    }

    /* Thêm style mới cho thead */
    .table-wrapper-scroll thead th {
        background-color: #f2f2f2 !important;
        color: #000 !important;
        font-weight: 600;
        border-bottom: 1px solid #dee2e6;
    }

    .table-wrapper-scroll th:nth-child(1),
    .table-wrapper-scroll td:nth-child(1) {
        width: 90px !important;
        min-width: 90px !important;
        max-width: 90px !important;
    }

